# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL: Your Supabase Project URL (e.g. https://xyz.supabase.co)
# Can also be entered dynamically inside the Super Admin Dashboard -> Supabase Backend tab.
VITE_SUPABASE_URL=""

# SUPABASE_ANON_KEY: Your Supabase anon public API key
# Can also be entered dynamically inside the Super Admin Dashboard -> Supabase Backend tab.
VITE_SUPABASE_ANON_KEY=""

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key for Neighborhood Guide & Places API (New).
VITE_GOOGLE_MAPS_API_KEY=""

# Optional Server-Side Default SMTP Settings (can also be configured live in CMS -> Email & SMTP)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_ENCRYPTION="tls"
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME="Kamal Hotel Reservations"
