# GEMINI_API_KEY: Optional AI key (AI Studio injects at runtime)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL of this server (used for payment callback/return URLs & links)
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Supabase Client Configuration (Browser-safe anon key ONLY)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
VITE_GOOGLE_MAPS_API_KEY=""
VITE_API_BASE_URL=""
VITE_PRODUCTION_MODE="false"

# Supabase Server Configuration (NEVER prefix SERVICE_ROLE_KEY with VITE_)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Security & Session Signing (Required in production, min 32 chars)
AUTH_TOKEN_SECRET=""
ALLOW_LOCAL_SQLITE_FALLBACK="true"
ALLOW_OTP_PREVIEW_IN_TEST="false"
FRESH_PRODUCTION_START="true"

# Cloudflare R2 Object Storage (Server-side presigned URLs)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_BASE_URL=""

# Payment Gateways (Server-side secrets — NEVER prefix with VITE_)
ESEWA_MERCHANT_CODE=""
ESEWA_SECRET_KEY=""
ESEWA_ENV="sandbox"

KHALTI_SECRET_KEY=""
KHALTI_ENV="sandbox"

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Nepal IRD CBMS Real-Time Tax Sync (optional until live registration)
IRD_CBMS_ENDPOINT=""
IRD_CBMS_USERNAME=""
IRD_CBMS_PASSWORD=""
IRD_CBMS_SELLER_PAN=""

# SMS / WhatsApp Gateways (optional — fails cleanly to queued if unset)
SPARROW_SMS_TOKEN=""
SPARROW_SMS_IDENTITY=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
TWILIO_WHATSAPP_FROM=""

# SMTP Outbound Email (optional — can also be encrypted & saved via Super Admin CMS)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_ENCRYPTION="tls"
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME="Kamal Hotel Reservations"
